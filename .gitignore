# Стани, не код. Тека лишається в репозиторії структурою (`.gitkeep`), вміст —
# ні: у ній історія правок конкретної інсталяції, кадри екранів і відкрита
# черга. Клон у чужий проєкт має починатися з порожньої теки, а не з чужих
# зауважень про чужі екрани.
data/*
!data/.gitkeep
!data/fixes/
data/fixes/*
!data/fixes/.gitkeep

# Машинозалежний конфіг: абсолютні шляхи, порти, шлях до виконавця.
# Створюється `node setup.mjs`, дефолти й перелік полів — у `config.mjs`.
harness.config.json

# Юніти, згенеровані з шаблонів під конкретну машину. Шаблони
# (`*.service.template`) у git їдуть, результат підстановки — ні. Сюди ж
# підпадають юніти, залишені попередніми інсталяціями: на робочій машині на них
# можуть указувати живі симлінки з ~/.config/systemd/user, тож файли лишаються
# на місці, але в репозиторій їм не треба — їх замінили шаблони.
generated-units/
*.service

# Логи й стан сторожа.
watchdog/dispatcher.log
watchdog/runs/
watchdog/state.json
*.log

# Резервні копії, що лишаються після міграцій сторів.
*.pre-*-migration
*.pre-*-rekey
