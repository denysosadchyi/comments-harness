[Unit]
# ЗГЕНЕРОВАНО з watchdog/watchdog.service.template — правити треба шаблон і
# перезапустити `node setup.mjs`, інакше наступна інсталяція затре правку.
#
# Сторож черги нотаток: висить на довгому полінгу сервера нот і на кожну подію
# запускає headless-виконавця. Сенс юніта — саме «завжди»: без нього сторожа
# тримала б жива сесія в терміналі, тобто правка стартувала б тільки поки
# хтось дивиться. Юніту потрібен linger для користувача, інакше він помре
# разом із логін-сесією (`loginctl enable-linger $USER`).
Description={{PREFIX}} comments-harness watchdog (queue dispatcher)
# Сервер нот названо в After, але не в Requires: сторож переживає його
# відсутність сам — ретрай із backoff і рядок у лозі, доки порт не відповість.
After=network-online.target {{PREFIX}}-notes.service

[Service]
Type=simple
WorkingDirectory={{PROJECT_ROOT}}
ExecStart={{NODE}} {{HARNESS_DIR}}/watchdog/dispatcher.mjs
Restart=always
RestartSec=5
# Нуль означає рівно одне: сторож зупинили свідомо (SIGTERM/SIGINT). Такий
# вихід підіймати назад не треба — звідси RestartPreventExitStatus=0.
#
# «Замок зайнято» під це правило НЕ підпадає й виходить з кодом 3. Раніше
# обидва випадки віддавали нуль, і це тихо ламало систему: юніт, який стартував,
# поки чергу тримав ручний сторож, виходив з нулем і не піднімався вже ніколи —
# навіть коли той сторож помирав. Черга лишалась без диспетчера, а `systemctl
# status` показував `inactive (dead)` з кодом 0, тобто вигляд повного порядку.
# Тепер код 3 підпадає під Restart=always, а рестарт-лупу немає, бо сам сторож
# на зайнятому замку витримує паузу (watchdog.busyWaitS, дефолт 30 с) перед
# виходом: один рядок у лозі приблизно раз на півхвилини, доки замок не звільнять.
#
# Падіння (код 1, ФАТАЛЬНО) і смерть від сигналу так само підіймає Restart=always.
RestartPreventExitStatus=0
# Рестарт сторожа не має вбивати правки, що вже в роботі. За замовчуванням
# systemd гасить усю cgroup — разом із виконавцем, який у цю мить редагує файл.
# KillMode=process зупиняє лише сам сторож; виконавці доживають прогін і самі
# закривають свої ноти на сервері нот.
KillMode=process
StandardInput=null
# systemd --user не читає профіль: виконавець (`claude`) зазвичай живе в
# ~/.local/bin, node — у /usr/bin. Не назвати PATH руками означає, що
# виконавці не знайдуть ані виконавця, ані npx.
Environment=PATH={{PATH}}
Environment=HOME={{HOME}}

[Install]
WantedBy=default.target
